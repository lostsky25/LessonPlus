generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["notifications"]
}

/// Техническая таблица исходящих событий. Диспетчер публикации ещё не реализован.
model OutboxEvent {
  id            String    @id @db.Uuid
  eventType     String    @map("event_type")
  schemaVersion Int       @map("schema_version")
  payload       Json
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  correlationId String    @map("correlation_id") @db.Uuid

  @@map("outbox_events")
  @@schema("notifications")
}

/// Уже обработанные входящие события. Повтор одного идентификатора не создаёт вторую строку.
model ProcessedEvent {
  id          String   @id @db.Uuid
  processedAt DateTime @map("processed_at") @db.Timestamptz(6)

  @@map("processed_events")
  @@schema("notifications")
}

model Notification {
  id            String   @id @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  subjectType   String   @map("subject_type")
  subjectId     String   @map("subject_id") @db.Uuid
  sourceEventId String   @map("source_event_id") @db.Uuid
  status        String
  channel       String
  recordedAt    DateTime @map("recorded_at") @db.Timestamptz(6)
  nextAttemptNo Int      @default(1) @map("next_attempt_no")

  @@unique([sourceEventId, studentId, channel])
  @@map("notifications")
  @@schema("notifications")
}
