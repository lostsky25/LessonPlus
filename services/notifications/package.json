    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "amqplib": "2.2.0",
    "dotenv": "18.0.6",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "typescript": "6.0.3"
  }
