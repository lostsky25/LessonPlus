# Локальные значения для учебного стенда. Это не боевые секреты.
# Скопируйте файл в .env: node scripts/init-env.mjs
#
# Приложения на хосте подключаются к localhost.
# Docker Compose подменяет адреса на имена контейнеров postgres и rabbitmq.

# Внешний порт PostgreSQL на хосте. Внутри сети Docker сервер всегда слушает 5432.
# POSTGRES_PORT=5432

POSTGRES_USER=lessonplus_admin
POSTGRES_PASSWORD=lessonplus_admin_local
POSTGRES_DB=lessonplus

SUBSCRIPTIONS_DB_PASSWORD=subscriptions_local
SCHEDULE_DB_PASSWORD=schedule_local
ATTENDANCE_DB_PASSWORD=attendance_local
TRANSFERS_DB_PASSWORD=transfers_local
NOTIFICATIONS_DB_PASSWORD=notifications_local

RABBITMQ_USER=lessonplus
RABBITMQ_PASSWORD=lessonplus_local

# Адреса для запуска приложений на хосте (pnpm dev).
RABBITMQ_URL=amqp://lessonplus:lessonplus_local@localhost:5672
SUBSCRIPTIONS_DATABASE_URL=postgresql://subscriptions_user:subscriptions_local@localhost:5432/lessonplus?sslmode=disable
SCHEDULE_DATABASE_URL=postgresql://schedule_user:schedule_local@localhost:5432/lessonplus?sslmode=disable
ATTENDANCE_DATABASE_URL=postgresql://attendance_user:attendance_local@localhost:5432/lessonplus?sslmode=disable
TRANSFERS_DATABASE_URL=postgresql://transfers_user:transfers_local@localhost:5432/lessonplus?sslmode=disable
NOTIFICATIONS_DATABASE_URL=postgresql://notifications_user:notifications_local@localhost:5432/lessonplus?sslmode=disable

SUBSCRIPTIONS_URL=http://localhost:3001
SCHEDULE_URL=http://localhost:3002
ATTENDANCE_URL=http://localhost:3003
TRANSFERS_URL=http://localhost:3004
NOTIFICATIONS_URL=http://localhost:3005

# Vite proxy на хосте. В контейнере web Compose задаёт http://api-gateway:3000.
API_PROXY_TARGET=http://localhost:3000

GATEWAY_PORT=3000
WEB_PORT=5173
